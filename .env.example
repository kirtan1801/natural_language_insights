# Model, as "provider:model" (any LangChain chat provider). Set the matching key.
LLM_MODEL=anthropic:claude-opus-5-5
ANTHROPIC_API_KEY=
# LLM_MODEL=openai:gpt-5                  OPENAI_API_KEY=...
# LLM_MODEL=google_genai:gemini-2.5-pro   GOOGLE_API_KEY=...
# LLM_MODEL=ollama:llama3.1               (local, no key; OLLAMA_BASE_URL if not localhost)

# Extra provider-specific model settings as JSON, e.g.
# LLM_KWARGS={"output_config": {"effort": "high"}}     (Anthropic)
# LLM_KWARGS={"temperature": 0}

# Optional overrides (defaults shown).
# PORT=8000
# JOB_WORKERS=4
# MAX_UPLOAD_MB=500
# QUERY_TIMEOUT_SECONDS=30
# MAX_SQL_ATTEMPTS=3
# MAX_RESULT_ROWS=1000
# DATABASE_PATH=data/database.db
# UPLOAD_DIRECTORY=data/uploads
